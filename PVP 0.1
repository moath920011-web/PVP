    CreateToggleOption("Enable Aim Assistant", Settings.Enabled, function(state) Settings.Enabled = state end)
    CreateToggleOption("Show FOV Circle", Settings.ShowFOV, function(state) Settings.ShowFOV = state end)
    
    CreateButtonOption("FOV Size", "150 (Medium)", function()
        if Settings.FOVRadius == 100 then Settings.FOVRadius = 150 return "150 (Medium)"
        elseif Settings.FOVRadius == 150 then Settings.FOVRadius = 220 return "220 (Large)"
        else Settings.FOVRadius = 100 return "100 (Small)" end
    end)

    CreateButtonOption("Aim Mode", "Static Center", function()
        if Settings.CircleMode == "Static" then Settings.CircleMode = "FollowMouse" return "Follow Mouse"
        else Settings.CircleMode = "Static" return "Static Center" end
    end)

    CreateButtonOption("Aim Part / Offset", "Head (Center)", function()
        if Settings.VerticalOffset == 0 then Settings.VerticalOffset = 1.5 Settings.TargetPart = "Head" return "Head (High)"
        elseif Settings.VerticalOffset == 1.5 then Settings.VerticalOffset = -1.2 Settings.TargetPart = "Head" return "Chest (Low)"
        else Settings.VerticalOffset = 0 Settings.TargetPart = "Head" return "Head (Center)" end
    end)

    CreateToggleOption("X-Ray ESP (Players)", Settings.XRayEnabled, function(state) Settings.XRayEnabled = state end)
    CreateToggleOption("Loot Radar (Items)", Settings.LootRadarEnabled, function(state) Settings.LootRadarEnabled = state end)

    local function UpdateXRay()
        for _, player in ipairs(Players:GetPlayers()) do
            if player ~= LocalPlayer and player.Character then
                local highlight = player.Character:FindFirstChild("XRayHighlight")
                if Settings.XRayEnabled and not IsInSafeZone(player.Character) then
                    if not highlight then
                        highlight = Instance.new("Highlight")
                        highlight.Name = "XRayHighlight"
                        highlight.FillColor = Color3.fromRGB(255, 50, 80)
                        highlight.FillTransparency = 0.5
                        highlight.OutlineColor = Color3.fromRGB(255, 255, 255)
                        highlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
                        highlight.Parent = player.Character
                    end
                else
                    if highlight then highlight:Destroy() end
                end
            end
        end
    end

    local function UpdatePlayerLootRadar()
        for _, player in ipairs(Players:GetPlayers()) do
            if player ~= LocalPlayer and player.Character then
                for _, child in ipairs(player.Character:GetChildren()) do
                    if child:IsA("Tool") and child:FindFirstChild("Handle") then
                        local hl = child.Handle:FindFirstChild("LootHighlight")
                        if Settings.LootRadarEnabled then
                            if not hl then
                                hl = Instance.new("Highlight")
                                hl.Name = "LootHighlight"
                                hl.FillColor = Color3.fromRGB(255, 215, 0)
                                hl.FillTransparency = 0.3
                                hl.OutlineColor = Color3.fromRGB(255, 255, 255)
                                hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
                                hl.Parent = child.Handle
                            end
                        else
                            if hl then hl:Destroy() end
                        end
                    end
                end
            end
        end
    end

    local function GetCenterPoint()
        if Settings.CircleMode == "Static" then
            return Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y / 2)
        else
            return Vector2.new(Mouse.X, Mouse.Y)
        end
    end

    local function GetClosestTarget()
        local localChar = LocalPlayer.Character
        if not localChar or not localChar:FindFirstChild("HumanoidRootPart") then return nil end
        local closestTarget = nil
        local shortestDistanceToScreen = Settings.FOVRadius
        local centerPoint = GetCenterPoint()

        for _, player in ipairs(Players:GetPlayers()) do
            if player ~= LocalPlayer and player.Character and player.Character:FindFirstChild(Settings.TargetPart) then
                local char = player.Character
                local humanoid = char:FindFirstChildOfClass("Humanoid")
                local targetPart = char[Settings.TargetPart]
                if humanoid and humanoid.Health > 0 and not IsInSafeZone(char) and IsVisible(targetPart) then
                    local screenPos, onScreen = Camera:WorldToViewportPoint(targetPart.Position)
                    if onScreen then
                        local dist = (Vector2.new(screenPos.X, screenPos.Y) - centerPoint).Magnitude
                        if dist < shortestDistanceToScreen then
                            shortestDistanceToScreen = dist
                            closestTarget = targetPart
                        end
                    end
                end
            end
        end
        return closestTarget
    end

    RunService.RenderStepped:Connect(function(dt)
        local centerPoint = GetCenterPoint()
        FOVCircle.Visible = Settings.ShowFOV and Settings.Enabled
        FOVCircle.Size = UDim2.new(0, Settings.FOVRadius * 2, 0, Settings.FOVRadius * 2)
        FOVCircle.Position = UDim2.new(0, centerPoint.X, 0, centerPoint.Y)

        LastCheckTime = LastCheckTime + dt
        if LastCheckTime >= CheckInterval then
            LastCheckTime = 0
            UpdateXRay()
            UpdatePlayerLootRadar()
        end

        if Settings.Enabled then
            local target = GetClosestTarget()
            if target then
                local adjustedPos = target.Position + Vector3.new(0, Settings.VerticalOffset, 0)
                Camera.CFrame = Camera.CFrame:Lerp(CFrame.new(Camera.CFrame.Position, adjustedPos), Settings.LockSpeed)
            end
        end
    end)

    UserInputService.InputBegan:Connect(function(input, gameProcessed)
        if not gameProcessed and input.KeyCode == Enum.KeyCode.K then
            MainFrame.Visible = not MainFrame.Visible
        end
    end)
end

