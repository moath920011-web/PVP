SubmitBtn.MouseButton1Click:Connect(function()
    local enteredKey = KeyBox.Text
    if enteredKey == "" or enteredKey == "Paste your license key here..." then
        StatusLabel.TextColor3 = Color3.fromRGB(255, 80, 80)
        StatusLabel.Text = "❌ Please enter a key!"
        return
    end

    SubmitBtn.Text = "Checking..."
    StatusLabel.TextColor3 = Color3.fromRGB(255, 255, 255)
    StatusLabel.Text = "⏳ Connecting to KeyAuth..."

    task.spawn(function()
        local name = "Moath.9.20011"
        local ownerid = "DTr7H3vPPD"
        local secret = "13fa8791d585af2d87b846874449316e2eb151499ae1755cd74aecf746c4ee1b"
        local version = "1.0"

        local url = string.format("https://keyauth.win/api/1.2/?name=%s&ownerid=%s&secret=%s&type=license&key=%s&ver=%s", name, ownerid, secret, enteredKey, version)
        
        local success, response = pcall(function()
            return game:HttpGet(url)
        end)
        
        if success and response then
            if response:match('"success":true') or response:match('"success": "true"') then
                StatusLabel.TextColor3 = Color3.fromRGB(0, 255, 128)
                StatusLabel.Text = "✅ Key Valid! Loading Script..."
                task.wait(1)
                LaunchMainScript()
            else
                StatusLabel.TextColor3 = Color3.fromRGB(255, 50, 50)
                StatusLabel.Text = "❌ Invalid Key or Expired!"
                SubmitBtn.Text = "Verify Key"
            end
        else
            StatusLabel.TextColor3 = Color3.fromRGB(255, 50, 50)
            StatusLabel.Text = "❌ Connection Failed!"
            SubmitBtn.Text = "Verify Key"
        end
    end)
end)
