-- دالة تشغيل الهاك بعد نجاح الكي
local function LaunchMainScript()
    ScreenGui:Destroy()
    
    local RunService = game:GetService("RunService")
    local Camera = workspace.CurrentCamera

    local Settings = {
        Enabled = true,
        ShowFOV = true,
        FOVRadius = 150,
    }

    local MainGui = Instance.new("ScreenGui")
    MainGui.Name = "HermanosCustomGui"
    MainGui.ResetOnSpawn = false
    MainGui.Parent = LocalPlayer:WaitForChild("PlayerGui")

    local FOVCircle = Instance.new("Frame")
    FOVCircle.AnchorPoint = Vector2.new(0.5, 0.5)
    FOVCircle.BackgroundTransparency = 1
    FOVCircle.Parent = MainGui

    local UIStroke = Instance.new("UIStroke")
    UIStroke.Color = Color3.fromRGB(0, 242, 254)
    UIStroke.Thickness = 2
    UIStroke.Parent = FOVCircle

    local UICornerCircle = Instance.new("UICorner")
    UICornerCircle.CornerRadius = UDim.new(1, 0)
    UICornerCircle.Parent = FOVCircle

    RunService.RenderStepped:Connect(function()
        FOVCircle.Visible = Settings.ShowFOV and Settings.Enabled
        FOVCircle.Size = UDim2.new(0, Settings.FOVRadius * 2, 0, Settings.FOVRadius * 2)
        FOVCircle.Position = UDim2.new(0, Camera.ViewportSize.X / 2, 0, Camera.ViewportSize.Y / 2)
    end)
end

-- زر التحقق بالخلفية لضمان عدم تعليق الشاشة
Button.MouseButton1Click:Connect(function()
    local key = TextBox.Text
    if key == "" then
        Status.TextColor3 = Color3.fromRGB(255, 80, 80)
        Status.Text = "Please enter a key!"
        return
    end

    Button.Text = "Checking..."
    Status.TextColor3 = Color3.fromRGB(255, 255, 255)
    Status.Text = "Connecting..."

    task.spawn(function()
        local name = "Moath.9.20011"
        local ownerid = "DTr7H3vPPD"
        local secret = "959fb413bbb5086fb63ad24d9474e0e300da6db87fedc93084b9610ed44b250b"
        local version = "1.0"

        local url = string.format("https://keyauth.win/api/1.2/?name=%s&ownerid=%s&secret=%s&type=license&key=%s&ver=%s", name, ownerid, secret, key, version)
        
        local success, response = pcall(function()
            return game:HttpGet(url)
        end)

        if success and response then
            if response:match('"success":true') or response:match('"success": "true"') then
                Status.TextColor3 = Color3.fromRGB(0, 255, 128)
                Status.Text = "Success! Loading..."
                task.wait(0.5)
                LaunchMainScript()
            else
                Status.TextColor3 = Color3.fromRGB(255, 80, 80)
                Status.Text = "Invalid or Expired Key!"
                Button.Text = "Verify Key"
            end
        else
            Status.TextColor3 = Color3.fromRGB(255, 50, 50)
            Status.Text = "Connection Error!"
            Button.Text = "Verify Key"
        end
    end)
end)
