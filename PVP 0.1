-- وظائف المتابعة والكشف
local function UpdateXRay()
    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= LocalPlayer and player.Character then
            local char = player.Character
            local highlight = char:FindFirstChild("XRayHighlight")

            if Settings.XRayEnabled and not IsInSafeZone(char) then
                if not highlight then
                    highlight = Instance.new("Highlight")
                    highlight.Name = "XRayHighlight"
                    highlight.FillColor = Color3.fromRGB(255, 0, 50)
                    highlight.FillTransparency = 0.5
                    highlight.OutlineColor = Color3.fromRGB(255, 255, 255)
                    highlight.OutlineTransparency = 0
                    highlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
                    highlight.Parent = char
                end
            else
                if highlight then highlight:Destroy() end
            end
        end
    end
end

local function UpdatePlayerLootRadar()
    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= LocalPlayer and player.Character then
            local char = player.Character
            for _, child in ipairs(char:GetChildren()) do
                if child:IsA("Tool") and child:FindFirstChild("Handle") then
                    local handle = child.Handle
                    local hl = handle:FindFirstChild("LootHighlight")
                    
                    if Settings.LootRadarEnabled then
                        if not hl then
                            hl = Instance.new("Highlight")
                            hl.Name = "LootHighlight"
                            hl.FillColor = Color3.fromRGB(255, 215, 0)
                            hl.FillTransparency = 0.3
                            hl.OutlineColor = Color3.fromRGB(255, 255, 255)
                            hl.OutlineTransparency = 0
                            hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
                            hl.Parent = handle
                        end
                    else
                        if hl then hl:Destroy() end
                    end
                end
            end
        end
    end
end

local function GetCenterPoint()
    if Settings.CircleMode == "Static" then
        return Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y / 2)
    else
        return Vector2.new(Mouse.X, Mouse.Y)
    end
end

local function GetClosestTarget()
    local localChar = LocalPlayer.Character
    if not localChar or not localChar:FindFirstChild("HumanoidRootPart") then return nil end

    local closestTarget = nil
    local shortestDistanceToScreen = Settings.FOVRadius
    local centerPoint = GetCenterPoint()

    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= LocalPlayer and player.Character and player.Character:FindFirstChild(Settings.TargetPart) then
            local char = player.Character
            local humanoid = char:FindFirstChildOfClass("Humanoid")
            local targetPart = char[Settings.TargetPart]

            if humanoid and humanoid.Health > 0 and not IsInSafeZone(char) and IsVisible(targetPart) then
                local screenPos, onScreen = Camera:WorldToViewportPoint(targetPart.Position)

                if onScreen then
                    local distanceToCenter = (Vector2.new(screenPos.X, screenPos.Y) - centerPoint).Magnitude

                    if distanceToCenter < shortestDistanceToScreen then
                        shortestDistanceToScreen = distanceToCenter
                        closestTarget = targetPart
                    end
                end
            end
        end
    end

    return closestTarget
end

RunService.RenderStepped:Connect(function(dt)
    local centerPoint = GetCenterPoint()

    FOVCircle.Visible = Settings.ShowFOV and Settings.Enabled
    FOVCircle.Size = UDim2.new(0, Settings.FOVRadius * 2, 0, Settings.FOVRadius * 2)
    FOVCircle.Position = UDim2.new(0, centerPoint.X, 0, centerPoint.Y)

    LastCheckTime = LastCheckTime + dt
    if LastCheckTime >= CheckInterval then
        LastCheckTime = 0
        UpdateXRay()
        UpdatePlayerLootRadar()
    end

    if Settings.Enabled then
        local target = GetClosestTarget()
        if target then
            local adjustedPosition = target.Position + Vector3.new(0, Settings.VerticalOffset, 0)
            local targetCFrame = CFrame.new(Camera.CFrame.Position, adjustedPosition)
            Camera.CFrame = Camera.CFrame:Lerp(targetCFrame, Settings.LockSpeed)
        end
    end
end)

